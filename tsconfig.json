{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/scripts/**/*",
    "packages/*/generated/**/*",
    "apps/*/src/**/*",
    "apps/*/*.config.ts",
    "apps/*/drizzle.config.ts"
  ]
}
