{
  "name": "texas-holdem",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "cards:build": "bun run --cwd packages/cards build",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "podman:up": "podman compose up --build -d",
    "podman:down": "podman compose down",
    "podman:logs": "podman compose logs -f",
    "infra:up": "docker compose up -d postgres valkey",
    "infra:down": "docker compose down",
    "infra:podman:up": "podman compose up -d postgres valkey",
    "infra:podman:down": "podman compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
